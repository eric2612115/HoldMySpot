{
  "name": "@holdmyspot/server",
  "version": "1.0.0",
  "private": true,
  "description": "HoldMySpot market server: order book on the queue fee, PayPal holds, captures and payouts, SSE.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "demo": "HMS_DEMO=1 HMS_DEMO_RESET=1 HMS_MARKET_START=2026-11-12T10:30:00-08:00 HMS_CLOCK_SPEED=60 node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "test:ai": "node --test --test-concurrency=1 \"test/ai/**/*.test.ts\"",
    "ai:eval": "node scripts/ai-eval.ts",
    "ai:render": "node scripts/render-receipts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@holdmyspot/shared": "file:../shared",
    "fastify": "5.12.7",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "1.5.6",
    "fast-check": "4.10.2",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "typescript": "~5.9.3"
  }
}
