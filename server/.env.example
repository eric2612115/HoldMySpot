# Copy to server/.env.local (git-ignored). Only HMS_* names are read from it, and a value
# already in the process environment wins. Never put a key here: name the file it is in.
#
# AI keys: extra dotenv files to read keys from, comma-separated. `#MODEL_API_KEY` narrows a
# file to that one name (the reader ignores every other line), for example:
# HMS_AI_KEY_FILES=/path/to/other-project/.env#MODEL_API_KEY
#
# Provider: auto (Anthropic if its key is found, else Muse Spark, else rules only), anthropic, muse, fake.
# HMS_AI_PROVIDER=auto
# Mode: fake runtime mode replays saved answers (no network) unless this says live.
# HMS_AI_MODE=replay
