node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example
# Third-party asset packs are cloned here for reference; only the models
# the app uses are copied into web/public/models (with their licence).
assets-src/*/repo/

# HoldMySpot server runtime data: SQLite database and uploaded photos.
server/data/

# Screenshots: only the final sets go into git: proto-shots/v2/final/ (the zero-key build, in the
# README) and proto-shots/v3/final/ (one hero errand on the real PayPal sandbox, D-121). Working
# shots (QA runs, proto-shots/v3/working/) stay local; earlier passes were moved out of the repo.
proto-shots/*
!proto-shots/v2/
proto-shots/v2/*
!proto-shots/v2/final/
!proto-shots/v3/
proto-shots/v3/*
!proto-shots/v3/final/

# Owner-only notes (may contain Chinese and machine-specific details); never committed.
private/

# Keys written by `npm run keys` (mode 600) and the launcher's logs and pid files.
.secrets/
.run/
