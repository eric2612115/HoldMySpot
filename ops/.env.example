# Copy to .env.local (git-ignored) and fill in what you need.

# Where the console gets its data: auto (server if it answers, else the mock), mock or server.
VITE_HMS_BACKEND=auto
# Base URL of the HoldMySpot API. Empty means same origin through the Vite proxy.
VITE_HMS_API=
# Only for a server that is not on a loopback host.
VITE_HMS_ADMIN_KEY=

# AG licences (docs/TECHNICAL-DETAILS.md "Keys"; docs/DECISIONS.md D-82, D-83). All optional: without keys every feature
# works in AG's trial mode (a console banner, and a watermark on hosts other than localhost). Read when
# `npm run dev` or `npm run build` starts; never printed. Never commit a key.
# AG Studio key, Pro with AI: the only key this console needs. Empty: the file named by
# HMS_AG_STUDIO_LICENSE_FILE is read instead (default ~/.config/paypal-hackathon/agstudio-license.txt).
VITE_AG_STUDIO_LICENSE_KEY=
# HMS_AG_STUDIO_LICENSE_FILE=
# AG Grid and AG Charts Enterprise key: only for a grid or chart drawn outside AG Studio (there is none).
# Empty: the file named by HMS_AG_LICENSE_FILE is read instead (default ~/.config/paypal-hackathon/aggrid-license.txt).
VITE_AG_LICENSE_KEY=
# HMS_AG_LICENSE_FILE=
# Extra host names the dev server answers, for `HOST_ALIAS=ops.holdmyspot.test npm run licence:check`.
# OPS_ALLOWED_HOSTS=ops.holdmyspot.test

# Screen words: plain (requests, offers, gap) or market (bids, asks, spread). See docs/DECISIONS.md D-37.
VITE_OPS_WORDS=plain
