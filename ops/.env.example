# Copy to .env.local (git-ignored) and fill in what you need.

# Where the console gets its data: auto (server if it answers, else the mock), mock or server.
VITE_HMS_BACKEND=auto
# Base URL of the HoldMySpot API. Empty means same origin through the Vite proxy.
VITE_HMS_API=
# Only for a server that is not on a loopback host.
VITE_HMS_ADMIN_KEY=
# AG licence (AG Grid + AG Charts Enterprise; also given to AG Studio). Leave empty to read the owner's
# key file instead (HMS_AG_LICENSE_FILE, default ~/.config/paypal-hackathon/aggrid-license.txt). Never commit a key.
VITE_AG_LICENSE_KEY=
# HMS_AG_LICENSE_FILE=
# Screen words: plain (requests, offers, gap) or market (bids, asks, spread). See docs/DECISIONS.md D-37.
VITE_OPS_WORDS=plain
